# AIGI-Holmes configuration template.
# Copy this file to ".env" before running the app locally.

# Database. SQLite works out of the box for local development.
DATABASE_URL=sqlite+aiosqlite:///./aigi_holmes.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aigi_holmes

# Optional Redis cache. Leave empty to disable cache if you do not run Redis.
REDIS_URL=

# Required for login sessions. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional admin role-management password.
ADMIN_ROLE_PASSWORD=

# Local development can keep "*"; production should use explicit origins.
ALLOWED_ORIGINS=*

# Model weights. Relative paths are resolved from the project root.
MODEL_PATH=finetuned_fake_real_resnet50.pth

# Optional Doubao AI analysis. Leave blank to disable AI explanation features.
DOUBAO_API_KEY=
DOUBAO_MODEL=

# Optional Serper web search API key. Leave blank to disable search features.
SERPER_API_KEY=
